# IEEE Transactions submission package.
#
# Figures, tables and macros are symlinked from ../paper: one source of truth,
# regenerated by ../paper/experiments.py. `make package` flattens the symlinks
# into a directory that can be zipped and uploaded.
PYTHON ?= python3
MAIN   := main
PKG    := package

.PHONY: all pdf check package clean

all: pdf check

pdf:
	latexmk -pdf -interaction=nonstopmode -halt-on-error $(MAIN).tex

check: ## verify the manuscript against the journal's formatting rules
	$(PYTHON) check_compliance.py

package: pdf ## assemble a self-contained upload directory (no symlinks)
	rm -rf $(PKG)
	mkdir -p $(PKG)
	cp -L $(MAIN).tex refs.bib $(MAIN).pdf $(PKG)/
	cp -L $(MAIN).bbl $(PKG)/ 2>/dev/null || true
	mkdir -p $(PKG)/data $(PKG)/figures
	cp -L data/macros.tex data/table_corpus.tex data/table_effectiveness.tex $(PKG)/data/
	for f in $$(grep -o 'includegraphics{[^}]*}' $(MAIN).tex | sed 's/.*{\(.*\)}/\1/'); do \
	  cp -L figures/$$f $(PKG)/figures/; done
	cp cover-letter.md $(PKG)/
	@echo "package ready: $(PKG)/ ($$(du -sh $(PKG) | cut -f1))"

clean:
	latexmk -C $(MAIN).tex
	rm -rf $(PKG) *.bbl *.blg
